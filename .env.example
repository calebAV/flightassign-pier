# Slack
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_CHANNEL=C0B3G4F2YP7

# Fleet API — bumped to 12h to cover full Shift 1 (4am posts need haulouts through 2pm)
FLEET_API_BASE=https://beta.api.fleet.aerovect.com
AIRPORT=ATL
HOURS_FORWARD=12

# Gate scope (T or A concourse, prefix match on single letters)
IN_SCOPE_GATES=T,A

# Pier scope. Two ways to configure:
#   1) Single contiguous range: set PIER_MIN and PIER_MAX (simplest, default)
#   2) Multiple disjoint ranges: set PIER_RANGES="40-60,75-85" (overrides PIER_MIN/MAX)
# Use PIER_RANGES when a future concourse opens on non-adjacent piers.
PIER_MIN=40
PIER_MAX=60
# PIER_RANGES=40-60          # optional; if set, takes precedence over PIER_MIN/MAX
# PIER_RANGES=40-60,75-85    # example: A piers + a future C-concourse pier range

# Haulout = departure - HAULOUT_LEAD_MIN. Flights with haulout in the past or past
# the current shift end are excluded.
HAULOUT_LEAD_MIN=55

# Display timezone (Python zoneinfo name). Used for shift detection and message clock times.
DISPLAY_TZ=America/New_York

# Shift configuration (24-hour local time, per DISPLAY_TZ)
# Shift 1: worked 5am-2pm; messages 4am-12:40pm; haulouts shown through 2pm
SHIFT1_WORKED_START_HOUR=5
SHIFT1_WORKED_END_HOUR=14
SHIFT1_MSG_START_HOUR=4
# Shift 1 message window ends when Shift 2 messages start (1pm) — no separate var.

# Shift 2: worked 2pm-10pm; messages 1pm-8:40pm; haulouts shown through 10pm
SHIFT2_WORKED_START_HOUR=14
SHIFT2_WORKED_END_HOUR=22
SHIFT2_MSG_START_HOUR=13
# Last Shift 2 message fires 1 hour before shift ends. To keep posting up to 10pm,
# set SHIFT2_MSG_END_HOUR=22.
SHIFT2_MSG_END_HOUR=21
