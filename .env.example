# Slack
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_CHANNEL=C0B3G4F2YP7

# Fleet API
FLEET_API_BASE=https://beta.api.fleet.aerovect.com
AIRPORT=ATL
HOURS_FORWARD=4

# Gate scope
# Comma-separated gate tokens. A bare letter ("T") is treated as a prefix and matches T01, T01A, T02...
# Specific gates like A01..A18 are matched exactly.
IN_SCOPE_GATES=T,A01,A02,A03,A04,A05,A06,A07,A08,A09,A10,A11,A12,A13,A14,A15,A16,A17,A18

# Pier scope (inclusive numeric range). Flights whose departure bag pier is
# outside [PIER_MIN, PIER_MAX] — or non-numeric — are excluded.
PIER_MIN=40
PIER_MAX=60

# Haulout = departure - HAULOUT_LEAD_MIN. Flights whose haulout time has already
# passed are excluded from each post (actionable-only).
HAULOUT_LEAD_MIN=55

# Timezone for display (Python zoneinfo name)
DISPLAY_TZ=America/New_York
